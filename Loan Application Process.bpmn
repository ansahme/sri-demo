<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:ns1="modeler" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:ns0="xmlns" id="bpmn_copilot_Definition_id" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="cb33e5f" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.5.0" ns0:modeler="http://camunda.org/schema/modeler/1.0" ns1:executionPlatform="Camunda Cloud" ns1:executionPlatformVersion="8.6">
  <bpmn:process id="carLoanOriginationProcess" name="Car Loan Origination Process" processType="None" isClosed="false" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ApplicationReceived" name="Car Loan Application Received">
      <bpmn:outgoing>Flow_0y5b9z3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0y5b9z3" sourceRef="StartEvent_ApplicationReceived" targetRef="Task_CollectInfo" />
    <bpmn:userTask id="Task_CollectInfo" name="Collect Applicant &#38; Vehicle Info">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="collectApplicantVehicleInfo" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y5b9z3</bpmn:incoming>
      <bpmn:outgoing>Flow_1u5p8yq</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1u5p8yq" sourceRef="Task_CollectInfo" targetRef="Task_PerformCreditCheck" />
    <bpmn:serviceTask id="Task_PerformCreditCheck" name="Perform Credit Check" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="creditBureauService" />
        <zeebe:ioMapping>
          <zeebe:output source="=creditScore" target="creditScore" />
          <zeebe:output source="=debtToIncomeRatio" target="debtToIncomeRatio" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1u5p8yq</bpmn:incoming>
      <bpmn:outgoing>Flow_0q9w7x5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0q9w7x5" sourceRef="Task_PerformCreditCheck" targetRef="Task_AssessEligibility" />
    <bpmn:businessRuleTask id="Task_AssessEligibility" name="Assess Eligibility" implementation="##unspecified">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="assessCarLoanEligibility" resultVariable="eligibilityResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0q9w7x5</bpmn:incoming>
      <bpmn:outgoing>Flow_1n8c4f0</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1n8c4f0" sourceRef="Task_AssessEligibility" targetRef="Gateway_IsEligible" />
    <bpmn:exclusiveGateway id="Gateway_IsEligible" name="Eligible?">
      <bpmn:incoming>Flow_1n8c4f0</bpmn:incoming>
      <bpmn:outgoing>Flow_Eligible_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Eligible_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Eligible_Yes" name="Yes" sourceRef="Gateway_IsEligible" targetRef="Task_UnderwriterReview">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibilityResult.eligible = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Eligible_No" name="No" sourceRef="Gateway_IsEligible" targetRef="Gateway_0anogud">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibilityResult.eligible = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Task_UnderwriterReview" name="Underwriter Review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="underwriterReview" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Eligible_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_1x0y2z3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1x0y2z3" sourceRef="Task_UnderwriterReview" targetRef="Gateway_IsApproved" />
    <bpmn:exclusiveGateway id="Gateway_IsApproved" name="Approved?">
      <bpmn:incoming>Flow_1x0y2z3</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Approved_Yes" name="Yes" sourceRef="Gateway_IsApproved" targetRef="Task_GenerateDocs">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved_No" name="No" sourceRef="Gateway_IsApproved" targetRef="Gateway_0anogud">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Task_RejectApplication" name="Notify Applicant of Rejection" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notificationService" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0y3125u</bpmn:incoming>
      <bpmn:outgoing>Flow_0b5c6d7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_0b5c6d7" sourceRef="Task_RejectApplication" targetRef="EndEvent_ApplicationRejected" />
    <bpmn:endEvent id="EndEvent_ApplicationRejected" name="Application Rejected">
      <bpmn:incoming>Flow_0b5c6d7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_GenerateDocs" name="Generate Loan Documents" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="documentGenerationService" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_1a2b3c4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1a2b3c4" sourceRef="Task_GenerateDocs" targetRef="Task_SignAgreement" />
    <bpmn:userTask id="Task_SignAgreement" name="Sign Loan Agreement">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="signLoanAgreement" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1a2b3c4</bpmn:incoming>
      <bpmn:outgoing>Flow_2d3e4f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2d3e4f5" sourceRef="Task_SignAgreement" targetRef="Task_DisburseFunds" />
    <bpmn:serviceTask id="Task_DisburseFunds" name="Disburse Funds to Dealership" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="paymentService" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_2d3e4f5</bpmn:incoming>
      <bpmn:outgoing>Flow_3f4g5h6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_3f4g5h6" sourceRef="Task_DisburseFunds" targetRef="Task_NotifyDisbursed" />
    <bpmn:serviceTask id="Task_NotifyDisbursed" name="Notify Applicant of Disbursement" implementation="##WebService">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notificationService" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_3f4g5h6</bpmn:incoming>
      <bpmn:outgoing>Flow_4g5h6i7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_4g5h6i7" sourceRef="Task_NotifyDisbursed" targetRef="EndEvent_LoanOriginated" />
    <bpmn:endEvent id="EndEvent_LoanOriginated" name="Loan Originated">
      <bpmn:incoming>Flow_4g5h6i7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_0anogud">
      <bpmn:incoming>Flow_Eligible_No</bpmn:incoming>
      <bpmn:incoming>Flow_Approved_No</bpmn:incoming>
      <bpmn:outgoing>Flow_0y3125u</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0y3125u" sourceRef="Gateway_0anogud" targetRef="Task_RejectApplication" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_carLoanOriginationProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_carLoanOriginationProcess" bpmnElement="carLoanOriginationProcess">
